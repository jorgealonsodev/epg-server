# Copy to .env and fill in. Never commit .env.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Gates the guide URL: https://<host>/<GUIDE_TOKEN>/epg.xml.gz
# Carried in the URL because players cannot send headers.
GUIDE_TOKEN=

# Gates /status and /refresh, sent as the X-Admin-Token header.
# Required behind a reverse proxy: every request then arrives with the proxy's
# own private address, so the private-caller check alone would admit anyone.
ADMIN_TOKEN=

# Upstream guide, comma-separated. More sources lift the coverage ceiling:
# channels absent from every source can never match.
EPG_SOURCES=https://iptv-epg.org/files/epg-es.xml.gz

# Hours between refreshes. Match the upstream regeneration cycle: reading
# faster gains nothing, slower lags behind schedule corrections.
REFRESH_HOURS=3

# Fuzzy match threshold. Raise it for stricter matching.
FUZZY_CUTOFF=0.92
