__pycache__/
*.pyc

# Runtime cache: rebuilt on every start.
data/cache/

# Never commit a playlist: stream URLs embed provider credentials.
*.m3u
*.m3u8
*.xml.gz

# Secrets: tokens live here, never in the repo.
.env

# Project context notes: kept locally, not tracked.
PROJECT-CONTEXT.md

# Engram memory store: local sync chunks, never tracked.
.engram/
